.PHONY: check-lit

check-lit: $(BUILD_OUT_PREFIX)jlc $(BUILD_OUT_PREFIX)jlm-opt
ifeq ($(LIT),)
	@echo "Error: lit is required to run tests. Please install lit (e.g. 'pip install lit' or 'apt install python3-lit') or specify its path with ./configure.sh --lit=<path>." >&2
	@exit 1
else
	$(LIT) -v $(LIT_ARGS) tests
endif

check: check-lit
