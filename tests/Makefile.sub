.PHONY: check-lit

LIT_TESTS = \
	tests/c-tests/test-array-struct.c \
	tests/c-tests/test-assertion.c \
	tests/c-tests/test-binary.c \
	tests/c-tests/test-call-by-value.c \
	tests/c-tests/test-casts.c \
	tests/c-tests/test-complex.c \
	tests/c-tests/test-conditional.c \
	tests/c-tests/test-constant-array.c \
	tests/c-tests/test-do-while.c \
	tests/c-tests/test-extractvalue.c \
	tests/c-tests/test-factorial.c \
	tests/c-tests/test-fctarray.c \
	tests/c-tests/test-fctptr.c \
	tests/c-tests/test-fibonacci.c \
	tests/c-tests/test-fnptr-loop \
	tests/c-tests/test-fp-arithmetic.c \
	tests/c-tests/test-fp-comparison.c \
	tests/c-tests/test-fprintf.c \
	tests/c-tests/test-gblfctarray.c \
	tests/c-tests/test-global-variable.c \
	tests/c-tests/test-irreducible.c \
	tests/c-tests/test-long-double.c \
	tests/c-tests/test-loop-return.c \
	tests/c-tests/test-main.c \
	tests/c-tests/test-memcpy.c \
	tests/c-tests/test-memcpy-null.c \
	tests/c-tests/test-printf.c \
	tests/c-tests/test-ptr-comparison.c \
	tests/c-tests/test-recfct.c \
	tests/c-tests/test-static-array.c \
	tests/c-tests/test-struct2.c \
	tests/c-tests/test-struct.c \
	tests/c-tests/test-switch.c \
	tests/c-tests/test-valist.c \
	tests/c-tests/test-vector-bitcast.c \
	tests/c-tests/test-vector-signextend.c \
	tests/c-tests/test-while-with-break.c \
	tests/c-tests/test-zeroinitialization.c

check-lit: $(BUILD_OUT_PREFIX)jlc $(BUILD_OUT_PREFIX)jlm-opt tests/lit.cfg.py $(LIT_TESTS)
ifeq ($(LIT),)
	@echo "Error: lit is required to run tests. Please install lit (e.g. 'pip install lit' or 'apt install python3-lit') or specify its path with ./configure.sh --lit=<path>." >&2
	@exit 1
else
	$(LIT) -v $(LIT_ARGS) $(LIT_TESTS)
endif

check: check-lit
